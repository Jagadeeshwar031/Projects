\\"\';


$LV_EMAIL_TEXT = \'Send-MailMessage -To [$LV_EMAIL_TO] -From [$LV_EMAIL_FROM] -SMTPServer [$LV_EMAIL_SERVER] -Subject [$LV_EMAIL_SUBJECT] -Body [$LV_EMAIL_BODY_FINAL] -BodyAsHtml\';

