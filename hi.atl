Return 0;', "x" = '-1', "y" = '-1')
CREATE FUNCTION FN_PERFORM_AUDIT_LOG($P_JOB_ID INT  IN, $P_AUDIT_OBJ VARCHAR(10)  IN, $P_STATUS VARCHAR(40)  IN, $P_LOADTYPE VARCHAR(10)  IN, $P_RECOVERY VARCHAR(4)  IN )
RETURNS  INT 
DECLARE
     $L_EXEC_ID INT ;
     $L_SYSTEM_DT DATETIME(9) ;
     $L_JOB_ID INT ;
     $L_JOB_NAME VARCHAR(100) ;
     $L_CONFIG_ID VARCHAR(100) ;
     $L_WORKFLOW_NAME VARCHAR(100) ;
     $L_WORKFLOW_ID INT ;
BEGIN
$L_EXEC_ID = job_run_id();$L_SYSTEM_DT = sysdate();$L_JOB_NAME = job_name();$L_CONFIG_ID = current_system_configuration();$L_WORKFLOW_NAME = workflow_name();IF (($P_AUDIT_OBJ = 'JOB') )
BEGIN
IF (($P_STATUS = 'STARTED') )
BEGIN
sql('DS_NHANA_INT', 'INSERT INTO STG_ETL_JOB_AUDIT Values ({$P_JOB_ID},{$L_JOB_NAME},{$P_LOADTYPE},{$L_SYSTEM_DT},NULL,{$L_CONFIG_ID},[$L_EXEC_ID],{$P_STATUS})');END
IF ((($P_STATUS = 'COMPLETED') OR
   ($P_STATUS = 'FAILED')) )
BEGIN
sql('DS_NHANA_INT', 'UPDATE STG_ETL_JOB_AUDIT SET JOB_STATUS={$P_STATUS},LOAD_END_DT={$L_SYSTEM_DT} WHERE JOB_RUN_ID={$L_EXEC_ID}');END
END
IF (($P_AUDIT_OBJ = 'WORKFLOW') )
BEGIN
$L_WORKFLOW_ID = sql('DS_REPO_METADATA', 'SELECT DISTINCT PARENT_OBJ_KEY FROM AL_PARENT_CHILD WHERE PARENT_OBJ={$L_WORKFLOW_NAME}');IF (($P_STATUS = 'STARTED') )
BEGIN
sql('DS_NHANA_INT', 'INSERT INTO STG_ETL_JOB_OBJECT_AUDIT Values ({$P_JOB_ID},{$L_JOB_NAME},{$L_EXEC_ID},{$L_CONFIG_ID},{$L_WORKFLOW_ID},{$L_WORKFLOW_NAME},{$P_LOADTYPE},{$L_SYSTEM_DT},NULL,{$P_STATUS},{$P_RECOVERY})');END
IF ((($P_STATUS = 'COMPLETED') OR
   ($P_STATUS = 'FAILED')) )
BEGIN
sql('DS_NHANA_INT', 'UPDATE STG_ETL_JOB_OBJECT_AUDIT SET WORKFLOW_STATUS={$P_STATUS},LOAD_END_DT={$L_SYSTEM_DT} WHERE JOB_RUN_ID={$L_EXEC_ID} AND WORKFLOW_ID={$L_WORKFLOW_ID}');END
END
RETURN 0;
END
