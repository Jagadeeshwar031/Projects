CREATE FUNCTION FN_CHECK_PREV_JOBS_STATUS($P_JOB_NAME VARCHAR(100)  IN, $P_CONFIG_ID VARCHAR(60)  IN )
RETURNS  INT 
DECLARE
     $L_CONFIG_ID VARCHAR(60) ;
     $L_JOB_NAME VARCHAR(100) ;
     $L_JOB_STATUS VARCHAR(50) ;
BEGIN
$L_JOB_NAME = $P_JOB_NAME;$L_CONFIG_ID = $P_CONFIG_ID;$L_Job_Status = nvl(sql('DS_NHANA_INT', 'select JOB_STATUS from STG_ETL_JOB_AUDIT  where JOB_NAME = {$L_JOB_NAME} and CONFIG_NAME = {$L_CONFIG_ID}
				and LOAD_START_DT = (select max(LOAD_START_DT) from STG_ETL_JOB_AUDIT where JOB_NAME  = {$L_JOB_NAME} and CONFIG_NAME = {$L_CONFIG_ID})'), 'No Execution Results');print('INFO - Job [$L_JOB_NAME] has not executed before, no previous STATUS found');print('INFO - Previous STATUS for Job [$L_JOB_NAME]; the STATUS is set to [$L_Job_Status] for previous execution');IF (($L_Job_Status = 'FAILED') )
RETURN -1;
ELSE
IF (($L_Job_Status = 'STARTED') )
RETURN 0;
ELSE
RETURN 1;
END
