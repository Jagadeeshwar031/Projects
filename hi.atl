##################################################################################

$P_CNTRL_SEQ=nvl($P_CNTRL_SEQ,0);
$L_OP_TYPE =SQL(\'DS_NHANA_INT\',\'SELECT DISTINCT FILE_OP_TYPE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND FILE_OP_TYPE={$P_OP_TYPE} AND CONTROL_SEQ=[$P_CNTRL_SEQ]\');		
print(\'operation type:[$L_OP_TYPE]\');

#########################################################
#*****************VALIDATION*****************************
#########################################################
IF(nvl($L_OP_TYPE,\'\')<>$P_OP_TYPE)raise_exception(\'File operation mismatch, please check operation type in table and function call\');

IF($L_OP_TYPE<>\'FILE_CHECK\' AND $L_OP_TYPE<>\'COPY\' AND $L_OP_TYPE<>\'RENAME\' AND $L_OP_TYPE<>\'MOVE\' AND $L_OP_TYPE<>\'ERROR\' AND $L_OP_TYPE<>\'ERRDELETE\' AND $L_OP_TYPE<>\'DELETE\' AND $L_OP_TYPE<>\'ZIP\' AND $L_OP_TYPE<>\'UNZIP\' AND $L_OP_TYPE<>\'SFTP\' AND $L_OP_TYPE<>\'SFTP_ARCHIVE\' AND $L_OP_TYPE<>\'CUSTOM\')
raise_exception(\'Invalid File Operation Type\' );

Print(\'#####################Information################################\');
Print(\'Input Parameter Job Name:[$P_JOB_NAME]\');
Print(\'Input Parameter File Operation Type:[$P_OP_TYPE]\');
Print(\'Input Parameter Control Sequence:[$P_CNTRL_SEQ]\');
Print(\'Input Parameter Prefix Value:[$P_PREFIX_VALUE]\');
Print(\'Input Parameter Postfix Value:[$P_POSTFIX_VALUE]\');

##########################################################
#*****************FILE CHECK VALIDATION****************************
##########################################################
IF($L_OP_TYPE=\'FILE_CHECK\')
begin
$L_CHK_FILE_NAMES=SQL(\'DS_NHANA_INT\',\'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} and PARAM_NAME=\\\'$GV_CHK_FILE_NAMES\\\'\');

#Print Filenames*************
Print(\'File Names to check:[$L_CHK_FILE_NAMES]\');

$L_CHK_FILE_NAMES=rtrim($L_CHK_FILE_NAMES,\',\')||\',\';
$L_CHK_FILE_PATH=SQL(\'DS_NHANA_INT\',\'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} and PARAM_NAME=\\\'$GV_CHK_FILE_PATH\\\'\');
$L_CHK_FILE_PATH=rtrim($L_CHK_FILE_PATH,\'\\\\\')||\'\\\\\';

#Print File Path*************
Print(\'File Path :[$L_CHK_FILE_PATH]\');
$L_CHK_FILE_INPUT_CNT=SQL(\'DS_NHANA_INT\',\'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} and PARAM_NAME=\\\'$GV_CHK_FILE_CNT\\\'\');

#Print Expected File count*************
Print(\'Expected File count :[$L_CHK_FILE_INPUT_CNT]\');
$L_COUNT_SEQ  = length(\'[$L_CHK_FILE_NAMES]\') - length(replace_substr_ext(\'[$L_CHK_FILE_NAMES]\', \',\', \'\',NULL,NULL));

while ( $L_COUNT_SEQ>0 )
	begin
$L_CHK_FILE_FULL_PATH =$L_CHK_FILE_PATH||word_ext( $L_CHK_FILE_NAMES,$L_COUNT_SEQ,\',\');
#Section to check multiple files with wildcard "*" ***********
      if(index($L_CHK_FILE_FULL_PATH,\'*\',1)>0)
       begin
       wait_for_file($L_CHK_FILE_FULL_PATH,1800000,180000,250,$L_CHK_FILE_NAMES_TEMP,$L_CHK_FILE_COUNTER,\';\');
	   Print(\'Files Available with "*" : [$L_CHK_FILE_NAMES_TEMP]\');
       $L_CHK_FILE_NAMES_TEMP=$L_CHK_FILE_NAMES_TEMP||\';\';
       $L_CHK_FILE_EXIST_CNT  =nvl($L_CHK_FILE_EXIST_CNT,0) +$L_CHK_FILE_COUNTER;
        while ( $L_CHK_FILE_COUNTER>0 )
	     begin
	     $L_CHK_FILE_FULL_PATH=word_ext($L_CHK_FILE_FULL_PATH,$L_CHK_FILE_COUNTER,\';\');
	     file_exists($L_CHK_FILE_FULL_PATH);
         $L_CHK_FILE_COUNTER=$L_CHK_FILE_COUNTER-1;
	     end
       end
#Section to check individual files ************************
	   else 
	   begin
       $L_CHK_FILE_COUNTER =file_exists($L_CHK_FILE_FULL_PATH);
       $L_CHK_FILE_EXIST_CNT  =nvl($L_CHK_FILE_EXIST_CNT,0) +$L_CHK_FILE_COUNTER;
       end  
$L_COUNT_SEQ=$L_COUNT_SEQ-1;

	end
#Print existing file count*****************************
Print(\'Existing File Count:[$L_CHK_FILE_EXIST_CNT]\');
$L_CHK_FILE_EXIST_CNT=  $L_CHK_FILE_EXIST_CNT-$L_CHK_FILE_INPUT_CNT;

$L_CHK_FILE_EXIST_CNT=nvl($L_CHK_FILE_EXIST_CNT,-1);########################################new

IF($L_CHK_FILE_EXIST_CNT<>0) 
begin
raise_exception(\'All source files are not placed, please check and re run the job\');
end 

return 0;
end

##########################################################
#*****************COPY COMMAND****************************
##########################################################
IF($L_OP_TYPE=\'COPY\')
begin
$L_FILE_FROM=SQL(\'DS_NHANA_INT\',\'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND  CONTROL_SEQ=[$P_CNTRL_SEQ] AND  PARAM_NAME=\\\'$GV_COPY_FILE_FROM\\\'\')||\'\\\\\';
$L_FILE_TO=SQL(\'DS_NHANA_INT\',\'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND  CONTROL_SEQ=[$P_CNTRL_SEQ]  AND PARAM_NAME=\\\'$GV_COPY_FILE_TO\\\'\')||\'\\\\\';
$L_FILE_NAME=SQL(\'DS_NHANA_INT\',\'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND  CONTROL_SEQ=[$P_CNTRL_SEQ] AND  PARAM_NAME=\\\'$GV_COPY_FILE_NAME\\\'\');
$L_FILE_EXISTS=wait_for_file($L_FILE_FROM||$L_FILE_NAME,10,2,250,$L_FILE_LIST,$L_FILE_COUNT,\'|\');

#Print log
PRINT(\'Copy file from location:[$L_FILE_FROM]\');
PRINT(\'Copy file to location:[$L_FILE_TO]\');
PRINT(\'Copy File name:[$L_FILE_NAME]\');
PRINT(\'Total files Copied:[$L_FILE_COUNT]\');

exec(\'cmd\',\'copy [$L_FILE_FROM][$L_FILE_NAME] [$L_FILE_TO]\',0);

end

