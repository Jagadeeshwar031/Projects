# Description
# Inserts a new record in to the Execution table 
####################################################

######Inserting a new record in to execution table ##########################

$L_EXEC_ID = job_run_id();
$L_SYSTEM_DT =sysdate();
$L_JOB_NAME=job_name();
$L_CONFIG_ID =current_system_configuration();
$L_WORKFLOW_NAME =workflow_name();


IF($P_AUDIT_OBJ=\'JOB\')
begin
     IF($P_STATUS=\'STARTED\')
       begin
        sql(\'DS_NHANA_INT\',\'INSERT INTO STG_ETL_JOB_AUDIT Values ({$P_JOB_ID},{$L_JOB_NAME},{$P_LOADTYPE},{$L_SYSTEM_DT},NULL,{$L_CONFIG_ID},[$L_EXEC_ID],{$P_STATUS})\');	
       end
     if($P_STATUS=\'COMPLETED\' OR $P_STATUS=\'FAILED\')
      begin
	  sql(\'DS_NHANA_INT\',\'UPDATE STG_ETL_JOB_AUDIT SET JOB_STATUS={$P_STATUS},LOAD_END_DT={$L_SYSTEM_DT} WHERE JOB_RUN_ID={$L_EXEC_ID}\');
      end
end

IF($P_AUDIT_OBJ=\'WORKFLOW\')
begin
$L_WORKFLOW_ID=sql(\'DS_REPO_METADATA\',\'SELECT DISTINCT PARENT_OBJ_KEY FROM AL_PARENT_CHILD WHERE PARENT_OBJ={$L_WORKFLOW_NAME}\');
     IF($P_STATUS=\'STARTED\')
       begin
	    sql(\'DS_NHANA_INT\',\'INSERT INTO STG_ETL_JOB_OBJECT_AUDIT Values ({$P_JOB_ID},{$L_JOB_NAME},{$L_EXEC_ID},{$L_CONFIG_ID},{$L_WORKFLOW_ID},{$L_WORKFLOW_NAME},{$P_LOADTYPE},{$L_SYSTEM_DT},NULL,{$P_STATUS},{$P_RECOVERY})\');	
       end
