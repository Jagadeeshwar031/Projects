 AlGUIComment ("ActaName_1" = 'RActa_user_func_category', "ActaName_2" = 'RParallelizable', "ActaName_3" = 'RisScriptValidationFunction', "ActaName_4" = 'RSavedAfterCheckOut', "ActaName_5" = 'RDate_created', "ActaName_6" = 'RDate_modified', "ActaValue_1" = 'User_Script_Function', "ActaValue_2" = 'no', "ActaValue_3" = 'no', "ActaValue_4" = 'YES', "ActaValue_5" = 'Tue Aug 13 16:36:17 2019', "ActaValue_6" = 'Wed Nov 27 19:07:59 2019', "InputSchema_WidthProp" = '35', "Input_1st_Column_Name" = 'Type', "Input_2nd_Column_Name" = 'Description', "Input_Column_Name_3" = 'Content_Type', "Input_Column_Name_4" = 'Business_Name', "Input_Column_Width_3" = '100', "Input_Column_Width_4" = '100', "Input_Width_Description" = '130', "Input_Width_Type" = '85', "Output_1st_Column_Name" = 'Type', "Output_2nd_Column_Name" = 'Mapping', "Output_3rd_Column_Name" = 'Description', "Output_Column_Name_4" = 'Content_Type', "Output_Column_Name_5" = 'Business_Name', "Output_Column_Width_4" = '100', "Output_Column_Width_5" = '100', "Output_Width_Decsription" = '130', "Output_Width_Mapping" = '85', "Output_Width_Type" = '80', "UpperContainer_HeightProp" = '39', "ui_script_text" = '# Function Name:	FN_AUDIT_LOG
# Description
# Inserts a new record in to the Execution table 
####################################################

######Inserting a new record in to execution table ##########################

$L_EXEC_ID = job_run_id();
$L_SYSTEM_DT =sysdate();
$L_JOB_NAME=job_name();
$L_CONFIG_ID =current_system_configuration();
$L_WORKFLOW_NAME =workflow_name();
PRINT(\'***********WORFLOW_NAME************[$L_WORKFLOW_NAME]\');

IF($P_AUDIT_OBJ=\'JOB\')
begin
     IF($P_STATUS=\'STARTED\')
       begin
       sql(\'DS_NHANA_INT\',\'INSERT INTO STG_ETL_JOB_AUDIT Values ({$P_JOB_ID},{$L_JOB_NAME},{$P_LOADTYPE},{$L_SYSTEM_DT},NULL,{$L_CONFIG_ID},{$L_EXEC_ID},{$P_STATUS})\');	
       end
     if($P_STATUS=\'COMPLETED\' OR $P_STATUS=\'FAILED\')
      begin
	  sql(\'DS_NHANA_INT\',\'UPDATE STG_ETL_JOB_AUDIT SET JOB_STATUS={$P_STATUS},LOAD_END_DT={$L_SYSTEM_DT} WHERE JOB_RUN_ID={$L_EXEC_ID}\');
      end
end

IF($P_AUDIT_OBJ=\'WORKFLOW\')
begin
$L_WORKFLOW_ID=sql(\'DS_REPO_METADATA\',\'SELECT DISTINCT PARENT_OBJ_KEY FROM AL_PARENT_CHILD WHERE PARENT_OBJ={$L_WORKFLOW_NAME}\');
     IF($P_STATUS=\'STARTED\')
       begin
	    sql(\'DS_NHANA_INT\',\'INSERT INTO STG_ETL_JOB_OBJECT_AUDIT Values ({$P_JOB_ID},{$L_JOB_NAME},{$L_EXEC_ID},{$L_CONFIG_ID},{$L_WORKFLOW_ID},{$L_WORKFLOW_NAME},{$P_LOADTYPE},{$L_SYSTEM_DT},NULL,{$P_STATUS},{$P_RECOVERY})\');	
       end
     if($P_STATUS=\'COMPLETED\' OR $P_STATUS=\'FAILED\')
      begin
	  sql(\'DS_NHANA_INT\',\'UPDATE STG_ETL_JOB_OBJECT_AUDIT SET WORKFLOW_STATUS={$P_STATUS},LOAD_END_DT={$L_SYSTEM_DT} WHERE JOB_RUN_ID={$L_EXEC_ID} AND WORKFLOW_ID={$L_WORKFLOW_ID}\');
      end
end




##############End #####################

Return 0;', "x" = '-1', "y" = '-1')
CREATE FUNCTION FN_AUDIT_LOG($P_JOB_ID INT  IN, $P_AUDIT_OBJ VARCHAR(10)  IN, $P_STATUS VARCHAR(40)  IN, $P_LOADTYPE VARCHAR(10)  IN, $P_RECOVERY VARCHAR(4)  IN )
RETURNS  INT 
DECLARE
     $L_EXEC_ID INT ;
     $L_SYSTEM_DT DATETIME(9) ;
     $L_JOB_ID INT ;
     $L_JOB_NAME VARCHAR(100) ;
     $L_CONFIG_ID VARCHAR(100) ;
     $L_WORKFLOW_NAME VARCHAR(100) ;
     $L_WORKFLOW_ID INT ;
BEGIN
$L_EXEC_ID = job_run_id();$L_SYSTEM_DT = sysdate();$L_JOB_NAME = job_name();$L_CONFIG_ID = current_system_configuration();$L_WORKFLOW_NAME = workflow_name();print('***********WORFLOW_NAME************[$L_WORKFLOW_NAME]');IF (($P_AUDIT_OBJ = 'JOB') )
BEGIN
IF (($P_STATUS = 'STARTED') )
BEGIN
sql('DS_NHANA_INT', 'INSERT INTO STG_ETL_JOB_AUDIT Values ({$P_JOB_ID},{$L_JOB_NAME},{$P_LOADTYPE},{$L_SYSTEM_DT},NULL,{$L_CONFIG_ID},{$L_EXEC_ID},{$P_STATUS})');END
IF ((($P_STATUS = 'COMPLETED') OR
   ($P_STATUS = 'FAILED')) )
BEGIN
sql('DS_NHANA_INT', 'UPDATE STG_ETL_JOB_AUDIT SET JOB_STATUS={$P_STATUS},LOAD_END_DT={$L_SYSTEM_DT} WHERE JOB_RUN_ID={$L_EXEC_ID}');END
END
IF (($P_AUDIT_OBJ = 'WORKFLOW') )
BEGIN
$L_WORKFLOW_ID = sql('DS_REPO_METADATA', 'SELECT DISTINCT PARENT_OBJ_KEY FROM AL_PARENT_CHILD WHERE PARENT_OBJ={$L_WORKFLOW_NAME}');IF (($P_STATUS = 'STARTED') )
BEGIN
sql('DS_NHANA_INT', 'INSERT INTO STG_ETL_JOB_OBJECT_AUDIT Values ({$P_JOB_ID},{$L_JOB_NAME},{$L_EXEC_ID},{$L_CONFIG_ID},{$L_WORKFLOW_ID},{$L_WORKFLOW_NAME},{$P_LOADTYPE},{$L_SYSTEM_DT},NULL,{$P_STATUS},{$P_RECOVERY})');END
IF ((($P_STATUS = 'COMPLETED') OR
   ($P_STATUS = 'FAILED')) )
BEGIN
sql('DS_NHANA_INT', 'UPDATE STG_ETL_JOB_OBJECT_AUDIT SET WORKFLOW_STATUS={$P_STATUS},LOAD_END_DT={$L_SYSTEM_DT} WHERE JOB_RUN_ID={$L_EXEC_ID} AND WORKFLOW_ID={$L_WORKFLOW_ID}');END
END
RETURN 0;
END
 AlGUIComment ("ActaName_1" = 'RActa_user_func_category', "ActaName_2" = 'RParallelizable', "ActaName_3" = 'RisScriptValidationFunction', "ActaName_4" = 'RSavedAfterCheckOut', "ActaName_5" = 'RDate_created', "ActaName_6" = 'RDate_modified', "ActaValue_1" = 'User_Script_Function', "ActaValue_2" = 'no', "ActaValue_3" = 'no', "ActaValue_4" = 'YES', "ActaValue_5" = 'Wed Aug 12 17:06:20 2020', "ActaValue_6" = 'Tue Aug 25 17:29:31 2020', "InputSchema_WidthProp" = '49', "Input_1st_Column_Name" = 'Type', "Input_2nd_Column_Name" = 'Description', "Input_Column_Name_3" = 'Content_Type', "Input_Column_Name_4" = 'Business_Name', "Input_Column_Width_3" = '100', "Input_Column_Width_4" = '100', "Input_Width_Description" = '130', "Input_Width_Type" = '85', "Output_1st_Column_Name" = 'Type', "Output_2nd_Column_Name" = 'Mapping', "Output_3rd_Column_Name" = 'Description', "Output_Column_Name_4" = 'Content_Type', "Output_Column_Name_5" = 'Business_Name', "Output_Column_Width_4" = '100', "Output_Column_Width_5" = '100', "Output_Width_Decsription" = '130', "Output_Width_Mapping" = '85', "Output_Width_Type" = '80', "UpperContainer_HeightProp" = '43', "ui_script_text" = '# *******************************************************************************************
# This script checks the long running jobs and sends an email with delayed message to the list of recepients.
# Created Date:8/8/2020
# Developer : Ram Mohan Chintada
# ************************************* Top of Code *****************************************
$LV_RUN_ID = job_run_id( );
$LV_START = 1;
$LV_JOB_NAME = job_name( );
#sleep(10000);
#This check the current status of the Job
$LV_STATUS = sql( \'DS_NHANA_INT\', \'select JOB_STATUS from STG_ETL_JOB_AUDIT where JOB_NAME = {$LV_JOB_NAME} and JOB_RUN_ID = (select max(JOB_run_ID) from STG_ETL_JOB_AUDIT where JOB_NAME = {$LV_JOB_NAME})\');

#Rechecks the status if the status is not started

while ( $LV_STATUS  <> \'STARTED\' )
	begin
		#sleep(5000);
		$LV_STATUS = sql( \'DS_NHANA_INT\', \'select JOB_STATUS from STG_ETL_JOB_AUDIT where JOB_NAME = {$LV_JOB_NAME} and JOB_RUN_ID = (select max(JOB_run_ID) from STG_ETL_JOB_AUDIT where JOB_NAME = {$LV_JOB_NAME})\');
		$LV_RUNID_MAX = sql( \'DS_NHANA_INT\', \'select JOB_RUN_ID from STG_ETL_JOB_AUDIT where JOB_NAME = {$LV_JOB_NAME} and JOB_RUN_ID = (select max(JOB_run_ID) from STG_ETL_JOB_AUDIT where JOB_NAME = {$LV_JOB_NAME})\');
		print( $LV_STATUS );
	end

#This loops the status checks based on the count $P_END
if ($LV_RUNID_MAX = $LV_RUN_ID and $LV_STATUS = \'STARTED\')
begin
while ( $LV_START <= $P_END )
	begin
		#print( $LV_START );
		sleep(1000);
		$LV_STATUS = sql( \'DS_NHANA_INT\', \'select JOB_STATUS from STG_ETL_JOB_AUDIT where JOB_NAME = {$LV_JOB_NAME} and JOB_RUN_ID = (select max(JOB_run_ID) from STG_ETL_JOB_AUDIT where JOB_NAME = {$LV_JOB_NAME})\');
		#print( $LV_STATUS );

		if ($LV_STATUS <> \'STARTED\')
		 begin
	      $LV_START = $P_END + 1;
         end
		else 
		 $LV_START = $LV_START + 1;
		 if ( $LV_START > $P_END and $LV_STATUS = \'STARTED\')
		 begin
		 $LV_START_TIME = sql( \'DS_NHANA_INT\', \'select LOAD_START_DT from STG_ETL_JOB_AUDIT where JOB_NAME = {$LV_JOB_NAME} and JOB_RUN_ID = (select max(JOB_run_ID) from STG_ETL_JOB_AUDIT where JOB_NAME = {$LV_JOB_NAME})\');
		 FN_DELAY_NOTIFICATION($LV_START_TIME);
		 end
    end
end
# ************************************* Bottom of Code *****************************************

Return 0;

', "x" = '-1', "y" = '-1')
CREATE FUNCTION FN_CHECK_JOB_DELAY($P_END INT  IN )
RETURNS  INT 
DECLARE
     $LV_START INT ;
     $LV_STATUS VARCHAR(40) ;
     $LV_JOB_NAME VARCHAR(100) ;
     $LV_START_TIME DATETIME(9) ;
     $LV_RUN_ID INT ;
     $LV_RUNID_MAX INT ;
BEGIN
$LV_RUN_ID = job_run_id();$LV_START = 1;$LV_JOB_NAME = job_name();$LV_STATUS = sql('DS_NHANA_INT', 'select JOB_STATUS from STG_ETL_JOB_AUDIT where JOB_NAME = {$LV_JOB_NAME} and JOB_RUN_ID = (select max(JOB_run_ID) from STG_ETL_JOB_AUDIT where JOB_NAME = {$LV_JOB_NAME})');WHILE (($LV_STATUS != 'STARTED') )
BEGIN
$LV_STATUS = sql('DS_NHANA_INT', 'select JOB_STATUS from STG_ETL_JOB_AUDIT where JOB_NAME = {$LV_JOB_NAME} and JOB_RUN_ID = (select max(JOB_run_ID) from STG_ETL_JOB_AUDIT where JOB_NAME = {$LV_JOB_NAME})');$LV_RUNID_MAX = sql('DS_NHANA_INT', 'select JOB_RUN_ID from STG_ETL_JOB_AUDIT where JOB_NAME = {$LV_JOB_NAME} and JOB_RUN_ID = (select max(JOB_run_ID) from STG_ETL_JOB_AUDIT where JOB_NAME = {$LV_JOB_NAME})');print($LV_STATUS);END
IF ((($LV_RUNID_MAX = $LV_RUN_ID) AND
   ($LV_STATUS = 'STARTED')) )
BEGIN
WHILE (($LV_START <= $P_END) )
BEGIN
sleep(1000);$LV_STATUS = sql('DS_NHANA_INT', 'select JOB_STATUS from STG_ETL_JOB_AUDIT where JOB_NAME = {$LV_JOB_NAME} and JOB_RUN_ID = (select max(JOB_run_ID) from STG_ETL_JOB_AUDIT where JOB_NAME = {$LV_JOB_NAME})');IF (($LV_STATUS != 'STARTED') )
BEGIN
$LV_START = ($P_END + 1);END
ELSE
$LV_START = ($LV_START + 1);IF ((($LV_START > $P_END) AND
   ($LV_STATUS = 'STARTED')) )
BEGIN
$LV_START_TIME = sql('DS_NHANA_INT', 'select LOAD_START_DT from STG_ETL_JOB_AUDIT where JOB_NAME = {$LV_JOB_NAME} and JOB_RUN_ID = (select max(JOB_run_ID) from STG_ETL_JOB_AUDIT where JOB_NAME = {$LV_JOB_NAME})');fn_delay_notification($LV_START_TIME);END
END
END
RETURN 0;
END
 AlGUIComment ("ActaName_1" = 'RActa_user_func_category', "ActaName_2" = 'RSavedAfterCheckOut', "ActaName_3" = 'RDate_created', "ActaName_4" = 'RDescription', "ActaName_5" = 'RDate_modified', "ActaName_6" = 'RParallelizable', "ActaName_7" = 'RisScriptValidationFunction', "ActaValue_1" = 'User_Script_Function', "ActaValue_2" = 'YES', "ActaValue_3" = 'Tue Aug 13 16:36:18 2019', "ActaValue_4" = 'Custom function to check the status of the previous execution of the job', "ActaValue_5" = 'Fri Jul 31 11:50:27 2020', "ActaValue_6" = 'no', "ActaValue_7" = 'no', "InputSchema_WidthProp" = '49', "Input_1st_Column_Name" = 'Type', "Input_2nd_Column_Name" = 'Description', "Input_Column_Name_3" = 'Content_Type', "Input_Column_Name_4" = 'Business_Name', "Input_Column_Width_3" = '100', "Input_Column_Width_4" = '100', "Input_Width_Description" = '130', "Input_Width_Type" = '85', "Output_1st_Column_Name" = 'Type', "Output_2nd_Column_Name" = 'Mapping', "Output_3rd_Column_Name" = 'Description', "Output_Column_Name_4" = 'Content_Type', "Output_Column_Name_5" = 'Business_Name', "Output_Column_Width_4" = '100', "Output_Column_Width_5" = '100', "Output_Width_Decsription" = '130', "Output_Width_Mapping" = '85', "Output_Width_Type" = '80', "UpperContainer_HeightProp" = '36', "ui_script_text" = '# Function Name:FN_CHECK_PREVIOUS _STATUS          
# -----------------------------------
# Parameters
#		Input
#			$P_JOB_NAME					Varchar(100)
#           $L_CONFIG_ID                Varchar(60)
#		Output
# 			Return 						int
# Variables
#			$L_JOB_NAME			     	Varchar(100)
#           $L_CONFIG_ID                Varchar(60)
#			$L_Job_Status				varchar(50)
# -----------------------------------
# Description:
# Reads the job parameter values to check for the status of the previous job 
# If the job hasn\'t run successfully return value 1 back, if OK then return 0.

# Extract individual fields from string stored in the parameter value
$L_JOB_NAME = $P_JOB_NAME;
$L_CONFIG_ID = $P_CONFIG_ID;

# Check previous job status
		$L_Job_Status = nvl( sql( \'DS_NHANA_INT\',\'select JOB_STATUS from STG_ETL_JOB_AUDIT  where JOB_NAME = {$L_JOB_NAME} and CONFIG_NAME = {$L_CONFIG_ID}
				and LOAD_START_DT = 
				(select max(LOAD_START_DT) from STG_ETL_JOB_AUDIT where JOB_NAME  = {$L_JOB_NAME} and CONFIG_NAME = {$L_CONFIG_ID})\'), \'No Execution Results\');

#Evaluate results and print messages to log
     if ($L_Job_Status = \'No Execution Results\')
         Print(\'INFO - Job [$L_JOB_NAME] has not executed before, no previous STATUS found\');
     else 
        Print(\'INFO - Previous STATUS for Job [$L_JOB_NAME]; the STATUS is set to [$L_Job_Status] for previous execution\');

# Exit if we have a successful completion or it is the first execution
     if ($L_Job_Status = \'COMPLETED\' OR $L_Job_Status = \'FAILED\' OR $L_Job_Status = \'No Execution Results\')
	    Return 0;
     else
        Return 1;', "x" = '-1', "y" = '-1')
CREATE FUNCTION FN_CHECK_PREVIOUS_STATUS($P_JOB_NAME VARCHAR(100)  IN, $P_CONFIG_ID VARCHAR(60)  IN )
RETURNS  INT 
DECLARE
     $L_JOB_NAME VARCHAR(100) ;
     $L_JOB_STATUS VARCHAR(50) ;
     $L_CONFIG_ID VARCHAR(60) ;
BEGIN
$L_JOB_NAME = $P_JOB_NAME;$L_CONFIG_ID = $P_CONFIG_ID;$L_Job_Status = nvl(sql('DS_NHANA_INT', 'select JOB_STATUS from STG_ETL_JOB_AUDIT  where JOB_NAME = {$L_JOB_NAME} and CONFIG_NAME = {$L_CONFIG_ID}
				and LOAD_START_DT = 
				(select max(LOAD_START_DT) from STG_ETL_JOB_AUDIT where JOB_NAME  = {$L_JOB_NAME} and CONFIG_NAME = {$L_CONFIG_ID})'), 'No Execution Results');IF (($L_Job_Status = 'No Execution Results') )
print('INFO - Job [$L_JOB_NAME] has not executed before, no previous STATUS found');ELSE
print('INFO - Previous STATUS for Job [$L_JOB_NAME]; the STATUS is set to [$L_Job_Status] for previous execution');IF (((($L_Job_Status = 'COMPLETED') OR
   ($L_Job_Status = 'FAILED')) OR
   ($L_Job_Status = 'No Execution Results')) )
RETURN 0;
ELSE
RETURN 1;
END
