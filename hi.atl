##########################################################
#*****************  RENAME COMMAND************************
##########################################################
#IF block 1
IF($L_OP_TYPE=\'RENAME\')
begin
$L_FILE_FROM =SQL(\'DS_NHANA_INT\',\'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ]  AND OP_VAR_NAME=\\\'$G_RENAME_FILE_FROM\\\'\');
$L_FILE_NAME =SQL(\'DS_NHANA_INT\',\'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\\\'$G_RENAME_FILE_NAME\\\'\');
$L_RENAME_FILE_NAME_TO =NVL($P_PREFIX_VALUE,\'\')||SQL(\'DS_NHANA_INT\',\'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\\\'$G_RENAME_FILE_NAME_TO\\\'\')||NVL($P_POSTFIX_VALUE,\'\');
$L_FILE_EXISTS=wait_for_file($L_FILE_FROM||$L_FILE_NAME,10,5,50,$L_FILE_LIST,$L_FILE_COUNT,\'|\');

#Print log
PRINT(\'Rename file from location:[$L_FILE_FROM]\');
PRINT(\'Rename file name: [$L_FILE_NAME]\');
PRINT(\'Total files Renamed:[$L_FILE_COUNT]\');
PRINT(\'File List to Rename:[$L_FILE_LIST]\');

#IF block 2
if($L_FILE_COUNT>0)
begin

$L_FILE_LIST=$L_FILE_LIST||\'|\';

#While loop
WHILE($L_FILE_COUNT>0)
begin
$L_FILE_NAME=word_ext($L_FILE_LIST,$L_FILE_COUNT,\'|\');
$L_FILE_NAME=word_ext($L_FILE_NAME,-1,\'/\');

$L_RENAME_FILE_NAME_TO=Word_ext($L_FILE_NAME,1,\'.\');
$L_RENAME_FILE_NAME_TO=NVL($P_PREFIX_VALUE,\'\')||$L_RENAME_FILE_NAME_TO||NVL($P_POSTFIX_VALUE,\'\');

#Print Log
Print(\'Rename file name:[$L_FILE_NAME]\');
Print(\'Rename file to :[$L_RENAME_FILE_NAME_TO]\');


EXEC(\'CMD\', \'RENAME [$L_FILE_FROM][$L_FILE_NAME] [$L_RENAME_FILE_NAME_TO]\', 0);
$L_FILE_COUNT=$L_FILE_COUNT-1;
end #End of While loop

end # End of IF block2

else PRINT(\'There are no files to rename:[$L_FILE_FROM][$L_FILE_NAME ]\');	

end # End of IF block1

##########################################################
#***************** ZIP COMMAND ***************************
##########################################################
IF($L_OP_TYPE=\'ZIP\')
begin
$L_FILE_FROM =SQL(\'DS_NHANA_INT\',\'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND PARAM_NAME=\\\'$G_ZIP_FILE_FROM\\\'\');
$L_FILE_TO =SQL(\'DS_NHANA_INT\',\'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ]  AND PARAM_NAME=\\\'$G_ZIP_FILE_TO\\\'\');
$L_FILE_NAME =SQL(\'DS_NHANA_INT\',\'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND PARAM_NAME=\\\'$G_ZIP_FILE_NAME\\\'\');
$L_ZIP_FILE_NAME_TO =NVL($P_PREFIX_VALUE,\'\')||SQL(\'DS_NHANA_INT\',\'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND PARAM_NAME=\\\'$G_ZIP_FILE_NAME_TO\\\'\')||NVL($P_POSTFIX_VALUE,\'\');

#Print log
PRINT(\'ZIP file from location:[$L_FILE_FROM]\');
PRINT(\'ZIP file to location: [$L_FILE_TO]\');
PRINT(\'ZIP file name: [$L_FILE_NAME]\');
PRINT(\'ZIP file name to: [$L_ZIP_FILE_NAME_TO]\');

print( exec(\'cmd\',\'7za a -tzip -y "\'|| $L_FILE_TO || $L_ZIP_FILE_NAME_TO ||\'.zip\'||\'" "\'|| $L_FILE_FROM || $L_FILE_NAME ||\'"\',0));

end

##########################################################
#***************** UNZIP COMMAND *************************
##########################################################
IF($L_OP_TYPE=\'UNZIP\')
begin
$L_FILE_FROM = SQL(\'DS_NHANA_INT\',\'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\\\'$G_UNZIP_FILE_FROM\\\'\');
$L_FILE_TO =SQL(\'DS_NHANA_INT\',\'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\\\'$G_UNZIP_FILE_TO\\\'\');
$L_FILE_NAME =NVL($P_PREFIX_VALUE,SQL(\'DS_NHANA_INT\',\'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\\\'$G_UNZIP_FILE_NAME\\\'\'));
$L_FILE_PASSWORD=SQL(\'DS_NHANA_INT\',\'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\\\'$G_UNZIP_FILE_PWD\\\'\');

#Print log
PRINT(\'UNZIP file from location:[$L_FILE_FROM]\');
PRINT(\'UNZIP file to location: [$L_FILE_TO]\');
PRINT(\'UNZIP file name: [$L_FILE_NAME]\');

print( exec(\'cmd\', \'7za e [$L_FILE_FROM][$L_FILE_NAME]  -o[$L_FILE_TO] -p[$L_FILE_PASSWORD]\',8));

#print( exec(\'unzip\', \'-j [$L_FILE_FROM][$L_FILE_NAME] -d [$L_FILE_TO]Out\',0));

end

##########################################################
#***************** SFTP COMMAND **************************
##########################################################
#Below SFTP command moves files from SFTP to NAS and vice versa
IF($L_OP_TYPE = \'SFTP\')
begin
$L_SFTP_NAS = sql(\'DS_NHANA_INT\',\'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME= {$P_JOB_NAME} and   OP_VAR_NAME=\\\'$G_SFTP_NAS\\\'\')||\'\\\\\';
$L_SFTP_PORT = SQL(\'DS_NHANA_INT\',\'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME = {$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\\\'$G_SFTP_PORT\\\'\');
$L_SFTP_AUTH_TYPE = SQL(\'DS_NHANA_INT\',\'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME = {$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\\\'$G_SFTP_AUTH_TYPE\\\'\');
$L_SFTP_PASSWORD = SQL(\'DS_NHANA_INT\',\'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME = {$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\\\'$G_SFTP_PASSWORD\\\'\');
$L_SFTP_PASS_PHRASE = SQL(\'DS_NHANA_INT\',\'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME = {$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\\\'$G_SFTP_PASS_PHRASE\\\'\');
IF ($L_SFTP_AUTH_TYPE = \'-pw\') $L_SFTP_PASSWORD = decrypt_aes($L_SFTP_PASSWORD, $L_SFTP_PASS_PHRASE, 256);
$L_SFTP_USER_ADDR = SQL(\'DS_NHANA_INT\',\'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME = {$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\\\'$G_SFTP_USER_ADDR\\\'\');
$L_SFTP_DIRECTORY = SQL(\'DS_NHANA_INT\',\'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME = {$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\\\'$G_SFTP_DIRECTORY\\\'\');
$L_SFTP_BATCH_PUT = sql( \'DS_NHANA_INT\',\'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME = {$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\\\'$G_BATCH_PUT\\\'\');
$L_SFTP_TGT_FILENAME = sql( \'DS_NHANA_INT\',\'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME = {$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\\\'$G_TGT_FILENAME\\\'\');
$L_SFTP_OP_TYPE = sql( \'DS_NHANA_INT\',\'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME = {$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\\\'$G_SFTP_OP_TYPE\\\'\');

#Print log
PRINT(\'SFTP NAS Location:[$L_SFTP_NAS]\');
PRINT(\'SFTP Port: [$L_SFTP_PORT]\');
PRINT(\'SFTP Authorization Type: [$L_SFTP_AUTH_TYPE]\');
PRINT(\'SFTP User Address:[$L_SFTP_USER_ADDR]\');
PRINT(\'SFTP Directory: [$L_SFTP_DIRECTORY]\');
PRINT(\'SFTP Batch File Name: [$L_SFTP_BATCH_PUT]\');
PRINT(\'SFTP File Name: [$L_SFTP_TGT_FILENAME]\');
PRINT(\'SFTP Operation Type: [$L_SFTP_OP_TYPE]\');

#$L_SFTP_STATUS = exec(\'[$L_SFTP_BATCH_PUT]\',\'[$L_SFTP_NAS] [$L_SFTP_DIRECTORY] [$L_SFTP_OP_TYPE] [$L_SFTP_TGT_FILENAME] [$L_SFTP_PORT] [$L_SFTP_AUTH_TYPE] [$L_SFTP_PASSWORD] [$L_SFTP_USER_ADDR]\',8);

PRINT (\'The Status of SFTP transfer is ---->*[$L_SFTP_STATUS]*\');

end 

##########################################################
#*********************SFTP ARCHIVE************************
##########################################################
#Below SFTP command moves files from SFTP to SFTP for achiving process

IF($L_OP_TYPE = \'SFTP_ARCHIVE\')
begin
$L_SFTP_NAS = sql(\'DS_NHANA_INT\',\'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME= {$P_JOB_NAME} and   OP_VAR_NAME=\\\'$G_SFTP_NAS\\\'\')||\'\\\\\';
$L_SFTP_PORT = SQL(\'DS_NHANA_INT\',\'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME = {$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\\\'$G_SFTP_PORT\\\'\');
$L_SFTP_AUTH_TYPE = SQL(\'DS_NHANA_INT\',\'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME = {$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\\\'$G_SFTP_AUTH_TYPE\\\'\');
$L_SFTP_PASSWORD = SQL(\'DS_NHANA_INT\',\'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME = {$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\\\'$G_SFTP_PASSWORD\\\'\');
$L_SFTP_PASS_PHRASE = SQL(\'DS_NHANA_INT\',\'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME = {$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\\\'$G_SFTP_PASS_PHRASE\\\'\');
IF ($L_SFTP_AUTH_TYPE = \'-pw\') $L_SFTP_PASSWORD = decrypt_aes($L_SFTP_PASSWORD, $L_SFTP_PASS_PHRASE, 256);
$L_SFTP_USER_ADDR = SQL(\'DS_NHANA_INT\',\'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME = {$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\\\'$G_SFTP_USER_ADDR\\\'\');
$L_SFTP_DIRECTORY = SQL(\'DS_NHANA_INT\',\'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME = {$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\\\'$G_SFTP_DIRECTORY\\\'\');
$L_SFTP_ARCH_DIRECTORY = SQL(\'DS_NHANA_INT\',\'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME = {$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\\\'$G_SFTP_ARCH_DIRECTORY\\\'\');
$L_SFTP_BATCH_PUT = sql( \'DS_NHANA_INT\',\'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME = {$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\\\'$G_BATCH_PUT\\\'\');
$L_SFTP_TGT_FILENAME = sql( \'DS_NHANA_INT\',\'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME = {$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\\\'$G_TGT_FILENAME\\\'\');
$L_SFTP_OP_TYPE = sql( \'DS_NHANA_INT\',\'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME = {$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\\\'$G_SFTP_OP_TYPE\\\'\');
#$L_SFTP_STATUS = exec(\'[$L_SFTP_BATCH_PUT]\',\'[$L_SFTP_NAS] [$L_SFTP_DIRECTORY] [$L_SFTP_OP_TYPE] [$L_SFTP_TGT_FILENAME] [$L_SFTP_PORT] [$L_SFTP_AUTH_TYPE] [$L_SFTP_PASSWORD] [$L_SFTP_USER_ADDR]\',8);

#Print log
PRINT(\'SFTP NAS Location:[$L_SFTP_NAS]\');
PRINT(\'SFTP Port: [$L_SFTP_PORT]\');
PRINT(\'SFTP Authorization Type: [$L_SFTP_AUTH_TYPE]\');
PRINT(\'SFTP User Address:[$L_SFTP_USER_ADDR]\');
PRINT(\'SFTP Directory: [$L_SFTP_DIRECTORY]\');
PRINT(\'SFTP Archive Directory: [$L_SFTP_ARCH_DIRECTORY]\');
PRINT(\'SFTP Batch File Name: [$L_SFTP_BATCH_PUT]\');
PRINT(\'SFTP File Name: [$L_SFTP_TGT_FILENAME]\');
PRINT(\'SFTP Operation Type: [$L_SFTP_OP_TYPE]\');

#$L_SFTP_STATUS =exec(\'[$L_SFTP_BATCH_PUT]\',\'[$L_SFTP_NAS] [$L_SFTP_DIRECTORY] [$L_SFTP_OP_TYPE] [$L_SFTP_TGT_FILENAME] [$L_SFTP_ARCH_DIRECTORY] [$L_SFTP_PORT] [$L_SFTP_AUTH_TYPE] [$L_SFTP_PASSWORD] [$L_SFTP_USER_ADDR]\',8);

PRINT (\'The Status of SFTP Archive is ---->*[$L_SFTP_STATUS]*\');

end
##########################################################
#***************** CUSTOM COMMAND*************************
##########################################################

IF($L_OP_TYPE=\'CUSTOM\')
begin
$L_CUSTOM_SCRIPT =SQL(\'DS_NHANA_INT\',\'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\\\'$G_CUSTOM_SCRIPT\\\'\');

#Print log
Print(\'Custom command script:[$L_CUSTOM_SCRIPT]\');
exec(\'CMD\',\'[$L_CUSTOM_SCRIPT]\');

end
Print(\'#####################Information End################################\');
RETURN 0;



', "x" = '-1', "y" = '-1')
CREATE FUNCTION FN_FILE_OPERATIONS_NEW($P_JOB_NAME VARCHAR(255)  IN, $P_OP_TYPE VARCHAR(20)  IN, $P_CNTRL_SEQ INT  IN, $P_PREFIX_VALUE VARCHAR(1000)  IN, $P_POSTFIX_VALUE VARCHAR(1000)  IN )
RETURNS  INT 
DECLARE
     $L_FILE_FROM VARCHAR(50000) ;
     $L_FILE_TO VARCHAR(50000) ;
     $L_FILE_NAME VARCHAR(50000) ;
     $L_DEL_FILE_DAYS INT ;
     $L_CONTROL_SEQ INT ;
     $L_COUNT_SEQ INT ;
     $L_OP_TYPE VARCHAR(50) ;
     $L_CUSTOM_SCRIPT VARCHAR(1000) ;
     $L_ZIP_FILE_TO VARCHAR(1000) ;
     $L_ZIP_FILE_NAME_TO VARCHAR(255) ;
     $L_VALIDATE_FUNC INT ;
     $L_SFTP_NAS VARCHAR(1000) ;
     $L_SFTP_PORT INT ;
     $L_SFTP_AUTH_TYPE VARCHAR(255) ;
     $L_SFTP_PASSWORD VARCHAR(255) ;
     $L_SFTP_PASS_PHRASE VARCHAR(500) ;
     $L_SFTP_USER_ADDR VARCHAR(500) ;
     $L_SFTP_DIRECTORY VARCHAR(1000) ;
     $L_SFTP_TGT_FILENAME VARCHAR(500) ;
     $L_SFTP_OP_TYPE VARCHAR(1000) ;
     $L_SFTP_BATCH_PUT VARCHAR(1000) ;
     $L_SFTP_STATUS VARCHAR(1000) ;
     $L_RENAME_FILE_NAME_TO VARCHAR(500) ;
     $L_SFTP_ARCH_DIRECTORY VARCHAR(1000) ;
     $L_FILE_EXISTS INT ;
     $L_FILE_LIST VARCHAR(50000) ;
     $L_FILE_COUNT INT ;
     $L_FILE_PASSWORD VARCHAR(100) ;
     $L_CHK_FILE_NAMES VARCHAR(50000) ;
     $L_CHK_FILE_PATH VARCHAR(50000) ;
     $L_CHK_FILE_INPUT_CNT INT ;
     $L_CHK_FILE_EXIST_CNT INT ;
     $L_CHK_FILE_FULL_PATH VARCHAR(50000) ;
     $L_CHK_FILE_COUNTER INT ;
     $L_CHK_FILE_NAMES_TEMP VARCHAR(50000) ;
BEGIN
$P_CNTRL_SEQ = nvl($P_CNTRL_SEQ, 0);$L_OP_TYPE = sql('DS_NHANA_INT', 'SELECT DISTINCT FILE_OP_TYPE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND FILE_OP_TYPE={$P_OP_TYPE} AND CONTROL_SEQ=[$P_CNTRL_SEQ]');print('operation type:[$L_OP_TYPE]');IF ((nvl($L_OP_TYPE,  NULL ) != $P_OP_TYPE) )
raise_exception('File operation mismatch, please check operation type in table and function call');IF ((((((((((((($L_OP_TYPE != 'FILE_CHECK') AND
   ($L_OP_TYPE != 'COPY')) AND
   ($L_OP_TYPE != 'RENAME')) AND
   ($L_OP_TYPE != 'MOVE')) AND
   ($L_OP_TYPE != 'ERROR')) AND
   ($L_OP_TYPE != 'ERRDELETE')) AND
   ($L_OP_TYPE != 'DELETE')) AND
   ($L_OP_TYPE != 'ZIP')) AND
   ($L_OP_TYPE != 'UNZIP')) AND
   ($L_OP_TYPE != 'SFTP')) AND
   ($L_OP_TYPE != 'SFTP_ARCHIVE')) AND
   ($L_OP_TYPE != 'CUSTOM')) )
raise_exception('Invalid File Operation Type');print('#####################Information################################');print('Input Parameter Job Name:[$P_JOB_NAME]');print('Input Parameter File Operation Type:[$P_OP_TYPE]');print('Input Parameter Control Sequence:[$P_CNTRL_SEQ]');print('Input Parameter Prefix Value:[$P_PREFIX_VALUE]');print('Input Parameter Postfix Value:[$P_POSTFIX_VALUE]');IF (($L_OP_TYPE = 'FILE_CHECK') )
BEGIN
$L_CHK_FILE_NAMES = sql('DS_NHANA_INT', 'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} and PARAM_NAME=\'$GV_CHK_FILE_NAMES\'');print('File Names to check:[$L_CHK_FILE_NAMES]');$L_CHK_FILE_NAMES = (rtrim($L_CHK_FILE_NAMES, ',') || ',');$L_CHK_FILE_PATH = sql('DS_NHANA_INT', 'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} and PARAM_NAME=\'$GV_CHK_FILE_PATH\'');$L_CHK_FILE_PATH = (rtrim($L_CHK_FILE_PATH, '\\') || '\\');print('File Path :[$L_CHK_FILE_PATH]');$L_CHK_FILE_INPUT_CNT = sql('DS_NHANA_INT', 'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} and PARAM_NAME=\'$GV_CHK_FILE_CNT\'');print('Expected File count :[$L_CHK_FILE_INPUT_CNT]');$L_COUNT_SEQ = (length('[$L_CHK_FILE_NAMES]') - length(replace_substr_ext('[$L_CHK_FILE_NAMES]', ',',  NULL ,  NULL ,  NULL )));WHILE (($L_COUNT_SEQ > 0) )
BEGIN
$L_CHK_FILE_FULL_PATH = ($L_CHK_FILE_PATH || word_ext($L_CHK_FILE_NAMES, $L_COUNT_SEQ, ','));IF ((index($L_CHK_FILE_FULL_PATH, '*', 1) > 0) )
BEGIN
wait_for_file($L_CHK_FILE_FULL_PATH, 1800000, 180000, 250, $L_CHK_FILE_NAMES_TEMP, $L_CHK_FILE_COUNTER, ';');print('Files Available with "*" : [$L_CHK_FILE_NAMES_TEMP]');$L_CHK_FILE_NAMES_TEMP = ($L_CHK_FILE_NAMES_TEMP || ';');$L_CHK_FILE_EXIST_CNT = (nvl($L_CHK_FILE_EXIST_CNT, 0) + $L_CHK_FILE_COUNTER);WHILE (($L_CHK_FILE_COUNTER > 0) )
BEGIN
$L_CHK_FILE_FULL_PATH = word_ext($L_CHK_FILE_FULL_PATH, $L_CHK_FILE_COUNTER, ';');file_exists($L_CHK_FILE_FULL_PATH);$L_CHK_FILE_COUNTER = ($L_CHK_FILE_COUNTER - 1);END
END
ELSE
BEGIN
$L_CHK_FILE_COUNTER = file_exists($L_CHK_FILE_FULL_PATH);$L_CHK_FILE_EXIST_CNT = (nvl($L_CHK_FILE_EXIST_CNT, 0) + $L_CHK_FILE_COUNTER);END
$L_COUNT_SEQ = ($L_COUNT_SEQ - 1);END
print('Existing File Count:[$L_CHK_FILE_EXIST_CNT]');$L_CHK_FILE_EXIST_CNT = ($L_CHK_FILE_EXIST_CNT - $L_CHK_FILE_INPUT_CNT);$L_CHK_FILE_EXIST_CNT = nvl($L_CHK_FILE_EXIST_CNT, -1);IF (($L_CHK_FILE_EXIST_CNT != 0) )
BEGIN
raise_exception('All source files are not placed, please check and re run the job');END
RETURN 0;
END
IF (($L_OP_TYPE = 'COPY') )
BEGIN
$L_FILE_FROM = (sql('DS_NHANA_INT', 'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND  CONTROL_SEQ=[$P_CNTRL_SEQ] AND  PARAM_NAME=\'$GV_COPY_FILE_FROM\'') || '\\');$L_FILE_TO = (sql('DS_NHANA_INT', 'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND  CONTROL_SEQ=[$P_CNTRL_SEQ]  AND PARAM_NAME=\'$GV_COPY_FILE_TO\'') || '\\');$L_FILE_NAME = sql('DS_NHANA_INT', 'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND  CONTROL_SEQ=[$P_CNTRL_SEQ] AND  PARAM_NAME=\'$GV_COPY_FILE_NAME\'');$L_FILE_EXISTS = wait_for_file(($L_FILE_FROM || $L_FILE_NAME), 10, 2, 250, $L_FILE_LIST, $L_FILE_COUNT, '|');print('Copy file from location:[$L_FILE_FROM]');print('Copy file to location:[$L_FILE_TO]');print('Copy File name:[$L_FILE_NAME]');print('Total files Copied:[$L_FILE_COUNT]');exec('cmd', 'copy [$L_FILE_FROM][$L_FILE_NAME] [$L_FILE_TO]', 0);END
IF (($L_OP_TYPE = 'MOVE') )
BEGIN
$L_FILE_FROM = (sql('DS_NHANA_INT', 'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME}  AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND PARAM_NAME=\'$GV_MOVE_FILE_FROM\'') || '\\');$L_FILE_TO = (sql('DS_NHANA_INT', 'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND PARAM_NAME=\'$GV_MOVE_FILE_TO\'') || '\\');$L_FILE_NAME = sql('DS_NHANA_INT', 'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND PARAM_NAME=\'$GV_MOVE_FILE_NAMES\'');$L_FILE_EXISTS = wait_for_file(($L_FILE_FROM || $L_FILE_NAME), 10, 2, 250, $L_FILE_LIST, $L_FILE_COUNT, '|');print('Move file from location:[$L_FILE_FROM]');print('Move file to location:[$L_FILE_TO]');print('Move File name:[$L_FILE_NAME]');print('Total files Moved:[$L_FILE_COUNT]');exec('cmd', 'MOVE [$L_FILE_FROM][$L_FILE_NAME] [$L_FILE_TO]', 0);END
IF (($L_OP_TYPE = 'ERROR') )
BEGIN
$L_FILE_FROM = (sql('DS_NHANA_INT', 'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME}  AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND PARAM_NAME=\'$GV_EMOVE_FILE_FROM\'') || '\\');$L_FILE_TO = (sql('DS_NHANA_INT', 'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND PARAM_NAME=\'$GV_EMOVE_FILE_TO\'') || '\\');$L_FILE_NAME = sql('DS_NHANA_INT', 'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND PARAM_NAME=\'$GV_EMOVE_FILE_NAMES\'');$L_FILE_EXISTS = wait_for_file(($L_FILE_FROM || $L_FILE_NAME), 10, 2, 100, $L_FILE_LIST, $L_FILE_COUNT, '|');print('Move file from location:[$L_FILE_FROM]');print('Move file to location:[$L_FILE_TO]');print('Move File name:[$L_FILE_NAME]');print('Total files Moved:[$L_FILE_COUNT]');exec('cmd', 'MOVE [$L_FILE_FROM][$L_FILE_NAME] [$L_FILE_TO]', 0);END
IF (($L_OP_TYPE = 'DELETE') )
BEGIN
$L_FILE_FROM = sql('DS_NHANA_INT', 'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ]  AND PARAM_NAME=\'$G_DELETE_FILE_FROM\'');$L_FILE_NAME = sql('DS_NHANA_INT', 'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ]  AND PARAM_NAME=\'$G_DELETE_FILE_NAMES\'');print('Delete file from location:[$L_FILE_FROM]');print('Delete File name:[$L_FILE_NAME]');print('Delete file older than:[$L_DEL_FILE_DAYS] days');print(exec('CMD', (('PUSHD "' || $L_FILE_FROM) || '" && (forfiles -m [$L_FILE_NAME] -c "cmd /c del @path")&POPD'), 8));END
IF (($L_OP_TYPE = 'ERRDELETE') )
BEGIN
$L_FILE_FROM = sql('DS_NHANA_INT', 'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ]  AND PARAM_NAME=\'$G_EDELETE_FILE_FROM\'');$L_FILE_NAME = sql('DS_NHANA_INT', 'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ]  AND PARAM_NAME=\'$G_EDELETE_FILE_NAMES\'');print('Delete file from location:[$L_FILE_FROM]');print('Delete File name:[$L_FILE_NAME]');print('Delete file older than:[$L_DEL_FILE_DAYS] days');print(exec('CMD', (('PUSHD "' || $L_FILE_FROM) || '" && (forfiles -m [$L_FILE_NAME] -c "cmd /c del @path")&POPD'), 8));END
IF (($L_OP_TYPE = 'RENAME') )
BEGIN
$L_FILE_FROM = sql('DS_NHANA_INT', 'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ]  AND OP_VAR_NAME=\'$G_RENAME_FILE_FROM\'');$L_FILE_NAME = sql('DS_NHANA_INT', 'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\'$G_RENAME_FILE_NAME\'');$L_RENAME_FILE_NAME_TO = ((nvl($P_PREFIX_VALUE,  NULL ) || sql('DS_NHANA_INT', 'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\'$G_RENAME_FILE_NAME_TO\'')) || nvl($P_POSTFIX_VALUE,  NULL ));$L_FILE_EXISTS = wait_for_file(($L_FILE_FROM || $L_FILE_NAME), 10, 5, 50, $L_FILE_LIST, $L_FILE_COUNT, '|');print('Rename file from location:[$L_FILE_FROM]');print('Rename file name: [$L_FILE_NAME]');print('Total files Renamed:[$L_FILE_COUNT]');print('File List to Rename:[$L_FILE_LIST]');IF (($L_FILE_COUNT > 0) )
BEGIN
$L_FILE_LIST = ($L_FILE_LIST || '|');WHILE (($L_FILE_COUNT > 0) )
BEGIN
$L_FILE_NAME = word_ext($L_FILE_LIST, $L_FILE_COUNT, '|');$L_FILE_NAME = word_ext($L_FILE_NAME, -1, '/');$L_RENAME_FILE_NAME_TO = word_ext($L_FILE_NAME, 1, '.');$L_RENAME_FILE_NAME_TO = ((nvl($P_PREFIX_VALUE,  NULL ) || $L_RENAME_FILE_NAME_TO) || nvl($P_POSTFIX_VALUE,  NULL ));print('Rename file name:[$L_FILE_NAME]');print('Rename file to :[$L_RENAME_FILE_NAME_TO]');exec('CMD', 'RENAME [$L_FILE_FROM][$L_FILE_NAME] [$L_RENAME_FILE_NAME_TO]', 0);$L_FILE_COUNT = ($L_FILE_COUNT - 1);END
END
ELSE
print('There are no files to rename:[$L_FILE_FROM][$L_FILE_NAME ]');END
IF (($L_OP_TYPE = 'ZIP') )
BEGIN
$L_FILE_FROM = sql('DS_NHANA_INT', 'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND PARAM_NAME=\'$G_ZIP_FILE_FROM\'');$L_FILE_TO = sql('DS_NHANA_INT', 'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ]  AND PARAM_NAME=\'$G_ZIP_FILE_TO\'');$L_FILE_NAME = sql('DS_NHANA_INT', 'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND PARAM_NAME=\'$G_ZIP_FILE_NAME\'');$L_ZIP_FILE_NAME_TO = ((nvl($P_PREFIX_VALUE,  NULL ) || sql('DS_NHANA_INT', 'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND PARAM_NAME=\'$G_ZIP_FILE_NAME_TO\'')) || nvl($P_POSTFIX_VALUE,  NULL ));print('ZIP file from location:[$L_FILE_FROM]');print('ZIP file to location: [$L_FILE_TO]');print('ZIP file name: [$L_FILE_NAME]');print('ZIP file name to: [$L_ZIP_FILE_NAME_TO]');print(exec('cmd', ((((((('7za a -tzip -y "' || $L_FILE_TO) || $L_ZIP_FILE_NAME_TO) || '.zip') || '" "') || $L_FILE_FROM) || $L_FILE_NAME) || '"'), 0));END
IF (($L_OP_TYPE = 'UNZIP') )
BEGIN
$L_FILE_FROM = sql('DS_NHANA_INT', 'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\'$G_UNZIP_FILE_FROM\'');$L_FILE_TO = sql('DS_NHANA_INT', 'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\'$G_UNZIP_FILE_TO\'');$L_FILE_NAME = nvl($P_PREFIX_VALUE, sql('DS_NHANA_INT', 'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\'$G_UNZIP_FILE_NAME\''));$L_FILE_PASSWORD = sql('DS_NHANA_INT', 'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\'$G_UNZIP_FILE_PWD\'');print('UNZIP file from location:[$L_FILE_FROM]');print('UNZIP file to location: [$L_FILE_TO]');print('UNZIP file name: [$L_FILE_NAME]');print(exec('cmd', '7za e [$L_FILE_FROM][$L_FILE_NAME]  -o[$L_FILE_TO] -p[$L_FILE_PASSWORD]', 8));END
IF (($L_OP_TYPE = 'SFTP') )
BEGIN
$L_SFTP_NAS = (sql('DS_NHANA_INT', 'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME= {$P_JOB_NAME} and   OP_VAR_NAME=\'$G_SFTP_NAS\'') || '\\');$L_SFTP_PORT = sql('DS_NHANA_INT', 'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME = {$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\'$G_SFTP_PORT\'');$L_SFTP_AUTH_TYPE = sql('DS_NHANA_INT', 'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME = {$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\'$G_SFTP_AUTH_TYPE\'');$L_SFTP_PASSWORD = sql('DS_NHANA_INT', 'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME = {$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\'$G_SFTP_PASSWORD\'');$L_SFTP_PASS_PHRASE = sql('DS_NHANA_INT', 'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME = {$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\'$G_SFTP_PASS_PHRASE\'');IF (($L_SFTP_AUTH_TYPE = '-pw') )
$L_SFTP_PASSWORD = decrypt_aes($L_SFTP_PASSWORD, $L_SFTP_PASS_PHRASE, 256);$L_SFTP_USER_ADDR = sql('DS_NHANA_INT', 'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME = {$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\'$G_SFTP_USER_ADDR\'');$L_SFTP_DIRECTORY = sql('DS_NHANA_INT', 'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME = {$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\'$G_SFTP_DIRECTORY\'');$L_SFTP_BATCH_PUT = sql('DS_NHANA_INT', 'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME = {$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\'$G_BATCH_PUT\'');$L_SFTP_TGT_FILENAME = sql('DS_NHANA_INT', 'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME = {$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\'$G_TGT_FILENAME\'');$L_SFTP_OP_TYPE = sql('DS_NHANA_INT', 'SELECT OP_VAR_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME = {$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND OP_VAR_NAME=\'$G_SFTP_OP_TYPE\'');print('SFTP NAS Location:[$L_SFTP_NAS]');print('SFTP Port: [$L_SFTP_PORT]');print('SFTP Authorization Type: [$L_SFTP_AUTH_TYPE]');print('SFTP User Address:[$L_SFTP_USER_ADDR]');print('SFTP Directory: [$L_SFTP_DIRECTORY]');print('SFTP Batch File Name: [$L_SFTP_BATCH_PUT]');print('SFTP File Name: [$L_SFTP_TGT_FILENAME]');print('SFTP Operation Type: [$L_SFTP_OP_TYPE]');print('The Status of SFTP transfer is ---->*[$L_SFTP_STATUS]*');END
IF (($L_OP_TYPE = 'SFTP_ARCHIVE') )
BEGIN
