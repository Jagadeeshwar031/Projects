CREATE FUNCTION MM_BILLING_FAILURE_NOTIFICATION($I_ERROR_MESSAGE VARCHAR(2000)  IN, $L_LOAD_START_DATE DATETIME(9)  IN )
RETURNS  INT 
DECLARE
     $LV_PROJ_NAME VARCHAR(100) ;
     $LV_EMAIL_TO VARCHAR(5000) ;
     $LV_ENV VARCHAR(10) ;
     $LV_EMAIL_SUBJECT VARCHAR(100) ;
     $LV_EMAIL_BODY_FINAL VARCHAR(5000) ;
     $LV_EMAIL_SERVER VARCHAR(100) ;
     $LV_EMAIL_FROM VARCHAR(100) ;
     $LV_EMAIL_TEXT VARCHAR(4000) ;
     $LV_BATCH_NUMBER VARCHAR(25) ;
     $LV_MAX_1 INT ;
     $LV_MAX_2 INT ;
     $LV_MAX_3 INT ;
     $LV_JOB_NAME VARCHAR(100) ;
     $LV_ERROR_MESSAGE VARCHAR(5000) ;
     $LV_JOB_ID INT ;
     $LV_SOURCE_TABLE VARCHAR(100) ;
     $LV_TARGET_TABLE VARCHAR(100) ;
     $LV_ERROR_TABLE VARCHAR(100) ;
     $LV_JOB_DESCRIPTION VARCHAR(1000) ;
     $RUN_ID INT ;
     $JOB_END_TIME DATETIME(9) ;
     $LV_SYS_CONFIG VARCHAR(25) ;
BEGIN
$LV_PROJ_NAME = job_name();$LV_EMAIL_TO = sql('DS_NHANA_INT', 'SELECT EMAIL_LIST_SUCCESS FROM STG_DS_JOB_NOTIFICATIONS Where JOB_NAME = {$LV_PROJ_NAME}');$LV_EMAIL_SERVER = 'smtprelay.energyaustralia.com.au';$LV_EMAIL_FROM = 'no-reply.bods@energyaustralia.com.au';$LV_SYS_CONFIG = current_system_configuration();$LV_JOB_NAME = job_name();$RUN_ID = job_run_id();$LV_TARGET_TABLE = 'MM_BILLING';$LV_ERROR_TABLE = 'MM_BILLING_ERR';$LV_JOB_DESCRIPTION = 'Loads C1 Billing files to Native Hana';$JOB_END_TIME = sysdate();IF (($LV_SYS_CONFIG = 'System_Config_NQ1') )
