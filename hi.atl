$L_FILE_FROM = SQL(\'DS_NHANA_INT\',\'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME}  AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND PARAM_NAME=\\\'$GV_MOVE_FILE_FROM\\\'\')||\'\\\\\';
$L_FILE_TO = SQL(\'DS_NHANA_INT\',\'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND PARAM_NAME=\\\'$GV_MOVE_FILE_TO\\\'\')||\'\\\\\';
$L_FILE_NAME = SQL(\'DS_NHANA_INT\',\'SELECT PARAM_VALUE FROM STG_ETL_JOB_PARAMS WHERE JOB_NAME={$P_JOB_NAME} AND CONTROL_SEQ=[$P_CNTRL_SEQ] AND PARAM_NAME=\\\'$GV_MOVE_FILE_NAMES\\\'\');
